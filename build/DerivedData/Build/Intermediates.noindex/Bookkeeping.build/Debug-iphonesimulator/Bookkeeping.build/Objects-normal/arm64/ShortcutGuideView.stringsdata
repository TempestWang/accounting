{
  "source": "/Users/tempestwang/workspace/accounting/Bookkeeping/Views/ShortcutGuideView.swift",
  "tables": {
    "Localizable": [
      {
        "comment": "",
        "key": "快捷指令搭建教程",
        "location": {
          "startingColumn": 26,
          "startingLine": 49
        }
      },
      {
        "comment": "",
        "key": "第一步：准备截图",
        "location": {
          "startingColumn": 21,
          "startingLine": 8
        }
      },
      {
        "comment": "",
        "key": "第二步：新建快捷指令「账本记账」",
        "location": {
          "startingColumn": 21,
          "startingLine": 17
        }
      },
      {
        "comment": "",
        "key": "第三步：用背面触发",
        "location": {
          "startingColumn": 21,
          "startingLine": 27
        }
      },
      {
        "comment": "",
        "key": "可选：分享面板直达",
        "location": {
          "startingColumn": 21,
          "startingLine": 35
        }
      },
      {
        "comment": "",
        "key": "可选：Siri 语音记账",
        "location": {
          "startingColumn": 21,
          "startingLine": 39
        }
      },
      {
        "comment": "",
        "key": "提示",
        "location": {
          "startingColumn": 21,
          "startingLine": 43
        }
      },
      {
        "comment": "",
        "key": "iOS 不允许快捷指令直接截取当前屏幕。推荐把「轻点背面两下」设为截屏：",
        "location": {
          "startingColumn": 22,
          "startingLine": 9
        }
      },
      {
        "comment": "",
        "key": "付款时：先敲两下背面截屏，截图会自动存进相册。",
        "location": {
          "startingColumn": 22,
          "startingLine": 12
        }
      },
      {
        "comment": "",
        "key": "设置 → 辅助功能 → 触控 → 轻点背面",
        "location": {
          "startingColumn": 23,
          "startingLine": 10
        }
      },
      {
        "comment": "",
        "key": "轻点两下 → 选择「截屏」",
        "location": {
          "startingColumn": 23,
          "startingLine": 11
        }
      },
      {
        "comment": "",
        "key": "打开「快捷指令」App，新建一个快捷指令，依次添加：",
        "location": {
          "startingColumn": 22,
          "startingLine": 18
        }
      },
      {
        "comment": "",
        "key": "运行后会自动打开 App 并进入「记一笔」页面，识别结果已预填，核对后保存即可。",
        "location": {
          "startingColumn": 22,
          "startingLine": 22
        }
      },
      {
        "comment": "",
        "key": "「获取最近的照片」",
        "location": {
          "startingColumn": 23,
          "startingLine": 19
        }
      },
      {
        "comment": "",
        "key": "「运行 账本 的『识别截图』」",
        "location": {
          "startingColumn": 23,
          "startingLine": 20
        }
      },
      {
        "comment": "",
        "key": "「图片」点「选择」→「变量」→ 选「最近的照片」",
        "location": {
          "startingColumn": 23,
          "startingLine": 21
        }
      },
      {
        "comment": "",
        "key": "设置 → 辅助功能 → 触控 → 轻点背面：",
        "location": {
          "startingColumn": 22,
          "startingLine": 28
        }
      },
      {
        "comment": "",
        "key": "使用：付款页面先敲两下截屏，再敲三下，即自动识别记账。",
        "location": {
          "startingColumn": 22,
          "startingLine": 30
        }
      },
      {
        "comment": "",
        "key": "轻点三下 → 快捷指令 → 选「账本记账」",
        "location": {
          "startingColumn": 23,
          "startingLine": 29
        }
      },
      {
        "comment": "",
        "key": "在快捷指令的详情里打开「在共享表单中显示」，付款截屏后点左下缩略图 → 分享 → 选「账本记账」，同样能自动记账。",
        "location": {
          "startingColumn": 22,
          "startingLine": 36
        }
      },
      {
        "comment": "",
        "key": "对着 Siri 说「用账本识别记账」，会直接运行该快捷指令（需要先把快捷指令收藏到 Siri 或说出完整短语）。",
        "location": {
          "startingColumn": 22,
          "startingLine": 40
        }
      },
      {
        "comment": "",
        "key": "自动记账可能存在识别误差，可在「明细」里核对，错误的直接左滑删除。识别分类的关键词可在 App 代码的 PaymentParser 中自定义扩充。",
        "location": {
          "startingColumn": 22,
          "startingLine": 44
        }
      }
    ]
  },
  "version": 1
}
